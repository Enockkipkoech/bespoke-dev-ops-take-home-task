# ---- Build Stage ----
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./tsconfig.json
COPY src/ ./src/
COPY Dockerfile ./Dockerfile

RUN npm run build

# ---- Runtime Stage ----
FROM node:18-alpine AS runtime

WORKDIR /app

RUN apk add --no-cache bash curl python3 py3-pip tmux && \
    pip3 install pytest --break-system-packages

COPY package*.json ./
RUN npm ci

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=builder /app/dist ./dist
COPY tsconfig.json ./tsconfig.json
COPY src/ ./src/
COPY k8s-deployment.yaml ./k8s-deployment.yaml
COPY Dockerfile ./Dockerfile

RUN chown -R appuser:appgroup /app
USER appuser

ENV PORT=3000
EXPOSE 3000

CMD ["node", "dist/index.js"]


# ------------------DOCKER 2------------------------------------

# ---- Build Stage ----
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./tsconfig.json
COPY src/ ./src/
COPY Dockerfile ./Dockerfile

RUN npm run build

# ---- Runtime Stage ----
FROM node:18-alpine AS runtime

WORKDIR /app

RUN apk add --no-cache bash curl python3 py3-pip tmux shadow && \
    pip3 install pytest --break-system-packages

COPY package*.json ./
RUN npm ci --omit=dev

RUN addgroup -S appgroup && \
    adduser -S -D -h /home/appuser -s /bin/bash -G appgroup appuser && \
    mkdir -p /home/appuser /tmp/tmux && \
    chown -R appuser:appgroup /home/appuser /tmp/tmux && \
    chmod 700 /home/appuser && \
    chmod 1777 /tmp /tmp/tmux

COPY --from=builder /app/dist ./dist
COPY tsconfig.json ./tsconfig.json
COPY src/ ./src/
COPY k8s-deployment.yaml ./k8s-deployment.yaml
COPY Dockerfile ./Dockerfile

RUN chown -R appuser:appgroup /app

USER appuser

ENV HOME=/home/appuser
ENV SHELL=/bin/bash
ENV TERM=xterm
ENV TMPDIR=/tmp

SHELL ["/bin/bash", "-c"]

EXPOSE 3000
CMD ["node", "dist/index.js"]